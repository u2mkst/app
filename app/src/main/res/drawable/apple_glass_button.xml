<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="oval">
            <solid android:color="#25000000" />
        </shape>
    </item>

    <item android:top="1dp" android:left="1dp" android:right="1dp" android:bottom="4dp">
        <shape android:shape="oval">
            <gradient
                android:startColor="#FF0088FF"
                android:endColor="#FF0044CC"
                android:angle="270" />
            <stroke
                android:width="1.5dp"
                android:color="#CCFFFFFF" />
        </shape>
    </item>

    <item android:top="2dp" android:left="4dp" android:right="4dp" android:bottom="26dp">
        <shape android:shape="oval">
            <gradient
                android:startColor="#E6FFFFFF"
                android:endColor="#00FFFFFF"
                android:angle="270" />
        </shape>
    </item>

    <item android:top="26dp" android:left="6dp" android:right="6dp" android:bottom="6dp">
        <shape android:shape="oval">
            <gradient
                android:startColor="#00FFFFFF"
                android:endColor="#60FFFFFF"
                android:angle="270" />
        </shape>
    </item>

</layer-list>