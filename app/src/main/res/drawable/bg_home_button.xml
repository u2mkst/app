<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <ripple android:color="#40FFFFFF">
            <item>
                <shape android:shape="oval">
                    <gradient
                        android:type="linear"
                        android:angle="135"
                        android:startColor="#2B7FE8"
                        android:endColor="#004BBF" />
                    <stroke
                        android:width="1.5dp"
                        android:color="#40FFFFFF" />
                </shape>
            </item>
        </ripple>
    </item>
    <!-- 은은한 유광 하이라이트: 좌상단에 흰색 라디얼 그라데이션을 얹어 입체감을 준다 -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="34dp"
                android:centerX="0.32"
                android:centerY="0.22"
                android:startColor="#38FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
