<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#E5E5EA"> <!-- 누를 때 퍼지는 회색 물결 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" /> <!-- 평소 하얀색 배경 -->
            <corners android:radius="10dp" /> <!-- 모서리를 10dp 깎음 -->
            <stroke android:width="1dp" android:color="#E8E8ED" /> <!-- 미세한 은색 테두리 -->
        </shape>
    </item>
</ripple>