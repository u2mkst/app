<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="360dp"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:background="#FFFFFF"
    android:orientation="vertical"
    android:padding="30dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="K&amp;P ADMIN"
        android:textColor="#0F172A"
        android:textSize="20sp"
        android:textStyle="bold"
        android:letterSpacing="0.03"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="6dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="시스템 관리자 전용 인증 패널"
        android:textColor="#64748B"
        android:textSize="12sp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="28dp"/>

    <EditText
        android:id="@+id/et_password"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="ACCESS CODE"
        android:textColorHint="#94A3B8"
        android:textColor="#0F172A"
        android:inputType="textPassword"
        android:background="@android:drawable/edit_text"
        android:backgroundTint="#F1F5F9"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:textSize="14sp"
        android:gravity="center"
        android:letterSpacing="0.1"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btn_exit"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="앱 나가기"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:backgroundTint="#004BBF"
        android:layout_marginBottom="20dp"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#EEF1F4"
        android:layout_marginBottom="14dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="6dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="현재 버전"
            android:textColor="#64748B"
            android:textSize="12sp"/>
        <TextView
            android:id="@+id/tv_current_version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="v-"
            android:textColor="#0F172A"
            android:textStyle="bold"
            android:textSize="11.5sp"
            android:fontFamily="monospace"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="업데이트"
            android:textColor="#64748B"
            android:textSize="12sp"/>
        <TextView
            android:id="@+id/tv_update_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="확인 중"
            android:textColor="#94A3B8"
            android:textSize="10.5sp"
            android:background="#EEF1F4"
            android:paddingLeft="9dp"
            android:paddingRight="9dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"/>
        <Button
            android:id="@+id/btn_update"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:visibility="gone"
            android:text="업데이트"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:backgroundTint="#004BBF"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="6dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="배터리"
            android:textColor="#64748B"
            android:textSize="12sp"/>
        <TextView
            android:id="@+id/tv_battery_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-"
            android:textColor="#0F172A"
            android:textStyle="bold"
            android:textSize="11.5sp"
            android:fontFamily="monospace"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="24dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="이어폰"
            android:textColor="#64748B"
            android:textSize="12sp"/>
        <TextView
            android:id="@+id/tv_earphone_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-"
            android:textColor="#0F172A"
            android:textStyle="bold"
            android:textSize="11.5sp"
            android:fontFamily="monospace"/>
    </LinearLayout>

    <TextView
        android:id="@+id/btn_diagnostics"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="진단 정보 보기"
        android:textColor="#004BBF"
        android:textSize="11.5sp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="10dp"
        android:clickable="true"
        android:focusable="true"/>

    <TextView
        android:id="@+id/btn_cancel"
        android:layout_width="120dp"
        android:layout_height="48dp"
        android:text="CANCEL"
        android:textColor="#94A3B8"
        android:textSize="12sp"
        android:letterSpacing="0.05"
        android:layout_gravity="center_horizontal"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"/>

</LinearLayout>
