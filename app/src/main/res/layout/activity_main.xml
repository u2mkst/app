<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kp_page_bg"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 🗂️ 탭 줄 + 상태 표시 (시각 / 네트워크 / 배터리 / QR / 블루투스 / 종료) -->
        <LinearLayout
            android:id="@+id/tabBar"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@color/kp_border"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="4dp">

            <HorizontalScrollView
                android:id="@+id/tabScroll"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/tabContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <ImageView
                android:id="@+id/ivNewTab"
                android:layout_width="36dp"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:contentDescription="새 탭"
                android:focusable="true"
                android:padding="9dp"
                android:src="@drawable/ic_add"
                app:tint="@color/kp_icon" />

            <TextView
                android:id="@+id/tvClock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:includeFontPadding="false"
                android:text="00:00"
                android:textColor="@color/kp_text"
                android:textSize="11sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/ivNetworkStatus"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:contentDescription="네트워크 상태 (탭하여 상세 정보 보기)"
                android:focusable="true"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_network_connected"
                app:tint="@color/kp_icon" />

            <ImageView
                android:id="@+id/ivBattery"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="2dp"
                android:contentDescription="배터리 상태"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_battery"
                app:tint="@color/kp_icon" />

            <TextView
                android:id="@+id/tvBattery"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:includeFontPadding="false"
                android:text="100%"
                android:textColor="@color/kp_muted"
                android:textSize="11sp" />

            <ImageView
                android:id="@+id/ivQrScan"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:contentDescription="QR 코드 스캔"
                android:focusable="true"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_qr_scan"
                app:tint="@color/kp_icon" />

            <ImageView
                android:id="@+id/ivBluetooth"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:contentDescription="블루투스 상태"
                android:focusable="true"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_bluetooth"
                app:tint="@color/kp_icon" />

            <ImageView
                android:id="@+id/ivQuit"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:contentDescription="앱 종료"
                android:focusable="true"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_quit"
                app:tint="@color/kp_danger" />
        </LinearLayout>

        <!-- 🧭 툴바 (뒤로 / 앞으로 / 새로고침 / 시작 페이지 / 주소창) -->
        <LinearLayout
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="@color/kp_surface"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="10dp">

            <ImageView
                android:id="@+id/ivBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="뒤로"
                android:focusable="true"
                android:padding="9dp"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/kp_icon" />

            <ImageView
                android:id="@+id/ivForward"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="앞으로"
                android:focusable="true"
                android:padding="9dp"
                android:src="@drawable/ic_arrow_forward"
                app:tint="@color/kp_icon" />

            <ImageView
                android:id="@+id/ivReload"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="새로고침"
                android:focusable="true"
                android:padding="9dp"
                android:src="@drawable/ic_refresh"
                app:tint="@color/kp_icon" />

            <ImageView
                android:id="@+id/ivHome"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="시작 페이지"
                android:focusable="true"
                android:padding="9dp"
                android:src="@drawable/ic_home"
                app:tint="@color/kp_icon" />

            <EditText
                android:id="@+id/etAddress"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_address_bar"
                android:hint="주소 입력 (선생님이 허용한 사이트만 열려요)"
                android:imeOptions="actionGo|flagNoExtractUi"
                android:importantForAutofill="no"
                android:inputType="textUri"
                android:maxLines="1"
                android:paddingStart="16dp"
                android:paddingTop="0dp"
                android:paddingEnd="16dp"
                android:paddingBottom="0dp"
                android:selectAllOnFocus="true"
                android:singleLine="true"
                android:textColor="@color/kp_text"
                android:textColorHint="@color/kp_muted"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- ⏳ 페이지 로딩 진행 막대 -->
        <ProgressBar
            android:id="@+id/pbLoading"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:max="100"
            android:progressTint="@color/kp_accent"
            android:visibility="gone" />

        <!-- 🔄 당겨서 새로고침 + 탭별 웹뷰가 들어가는 영역 -->
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefreshLayout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <FrameLayout
                android:id="@+id/webContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
